# Frontend Environment Variables
# Copy this file to .env and update with your actual production URLs

# Backend API URL (Production)
REACT_APP_API_URL=https://your-backend-api-domain.com

# Dashboard URL (Production)
REACT_APP_DASHBOARD_URL=https://your-dashboard-domain.com

# Note: In development, these default to localhost URLs
# See src/config/api.config.js for defaults
